<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home page</title>
</head>
<body>
    <h1>DASHBOARD </h1>
    <div>
        <h3> <% if(data)
            {%> 
            <%data.forEach((users)=> 
            {%>
                <h1><%= users.id %></h1>
                <h2><%= users.name %></h2>
                <h3><%= users.email %></h3>
                <h4><%= users.address %></h4>
                <h5><%= users.city %></h5>
                
            <%})
            %>
            <%}
            %>
        </h3>

    </div>
</body>
</html>